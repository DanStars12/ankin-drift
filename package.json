{
  "name": "ankin-drift-checks",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:archive": "node --test tests/archive.test.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "test:smoke": "playwright test",
    "test": "npm run check:syntax && npm run test:archive && npm run check:pwa && npm run test:smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "parse5": "8.0.1"
  }
}
